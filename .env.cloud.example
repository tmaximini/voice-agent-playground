# LiveKit Cloud credentials for `pnpm dev:cloud` (copy to .env.cloud).
# Create a project at https://cloud.livekit.io — for EU processing, pick an
# EU-pinned project/region. These are LiveKit credentials only; provider keys
# (Deepgram/LLM/TTS) stay BYOK in the browser and never live in env files.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
