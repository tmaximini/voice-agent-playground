{
  "name": "voice-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only, BYOK playground for building and benchmarking realtime voice-agent pipelines.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev:frontend": "pnpm -F @voice-playground/frontend dev",
    "dev:worker": "pnpm -F @voice-playground/worker dev",
    "dev:cloud": "bash scripts/dev-cloud.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  }
}
