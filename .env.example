# ============================================================================
# voice-playground — environment variables (documented across all packages)
# Copy the relevant block into each package. Provider keys are NOT here:
# they are supplied per-session by the user in the browser (BYOK) and never
# stored on any server.
# ============================================================================

# --- Fully-local Docker stack (docker-compose.yml) ---
# Your machine's LAN IP, so a host browser and the agent container can both
# reach containerized WebRTC media. Compose reads this from a root .env file.
#   macOS (Wi-Fi):  echo "NODE_IP=$(ipconfig getifaddr en0)" > .env
#   Linux:          echo "NODE_IP=$(hostname -I | awk '{print $1}')" > .env
NODE_IP=
# Local dev LiveKit creds (match infra/livekit.yaml; secret must be >=32 chars):
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=devsecret0123456789abcdef0123456789

# --- Cloudflare Worker (secrets: set via `wrangler secret put <NAME>`,
#     or packages/worker/.dev.vars for local `wrangler dev`) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker vars (wrangler.toml [vars]). Local Docker default is ws://localhost:7880;
# for LiveKit Cloud use wss://<your-project>.livekit.cloud
LIVEKIT_URL=ws://localhost:7880
ALLOWED_ORIGIN=http://localhost:5173

# --- Frontend (Vite, public — prefix VITE_) ---
VITE_WORKER_URL=http://localhost:8787/api

# --- Agent worker (Docker sets these in docker-compose.yml; only needed when
#     running the agent BARE on the host) ---
# Against the local Docker LiveKit: ws://localhost:7880 (+ devkey / devsecret...).
# Against LiveKit Cloud:            wss://<your-project>.livekit.cloud
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# NOTE: Deepgram / OpenRouter / ElevenLabs keys are NOT set here.
# They arrive per-session via BYOK and are used only for that session.
